{
  "manifest_version": 3,
  "name": "Flashsale Lokal — Shopee Bridge",
  "description": "Hubungkan satu tab Shopee yang kamu pilih ke dashboard lokal, tanpa menyalin cookie.",
  "version": "0.6.3",
  "minimum_chrome_version": "116",
  "permissions": ["activeTab", "scripting"],
  "host_permissions": ["https://shopee.co.id/*"],
  "background": {"service_worker": "background.js"},
  "action": {"default_popup": "popup.html"},
  "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'; connect-src ws://127.0.0.1:8765"}
}
